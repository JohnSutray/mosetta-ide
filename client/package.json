{
  "name": "@mosetta/ide-client",
  "version": "0.0.14",
  "description": "The Mosetta IDE client: the core that brings plugins up, and `mount()` to put the IDE into any element of a page.",
  "license": "MIT",
  "homepage": "https://ide.mosetta.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosetta/mosetta-ide.git",
    "directory": "client"
  },
  "bugs": "https://github.com/mosetta/mosetta-ide/issues",
  "keywords": [
    "mosetta",
    "ide"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./embed": "./src/embed.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "stable": "vite preview --port 4000 --strictPort"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.3",
    "@mosetta/ide-api": "workspace:*",
    "@mosetta/ide-protocol": "workspace:*",
    "@lezer/highlight": "^1.2.1",
    "@preact/signals": "^1.3.1",
    "ajv": "^8.17.1",
    "preact": "^10.25.3",
    "vite": "^6.0.5",
    "@preact/preset-vite": "^2.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "vitest": "^2.1.9"
  },
  "files": [
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "README.md",
    "!src/**/*.test.*"
  ]
}
