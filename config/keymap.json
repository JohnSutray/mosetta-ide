{
  "version": 1,
  "bindings": [
    { "command": "file.save", "key": "mod+s", "when": "global" },

    { "command": "search.everywhere", "key": "double:shift", "when": "global" },
    { "command": "search.everywhere", "key": "mod+p", "when": "global" },
    { "command": "search.next", "key": "arrowdown", "when": "search" },
    { "command": "search.prev", "key": "arrowup", "when": "search" },
    { "command": "search.accept", "key": "enter", "when": "search" },
    { "command": "search.close", "key": "escape", "when": "search" },

    { "command": "popup.close", "key": "escape", "when": "global" },

    { "command": "projects.next", "key": "arrowdown", "when": "projects" },
    { "command": "projects.prev", "key": "arrowup", "when": "projects" },
    { "command": "projects.suggest", "key": "mod+space", "when": "projects" },
    { "command": "projects.complete", "key": "tab", "when": "projects" },
    { "command": "projects.accept", "key": "enter", "when": "projects" },
    { "command": "projects.close", "key": "escape", "when": "projects" },

    { "command": "pick.next", "key": "arrowdown", "when": "pick" },
    { "command": "pick.prev", "key": "arrowup", "when": "pick" },
    { "command": "pick.accept", "key": "enter", "when": "pick" },
    { "command": "pick.expand", "key": "arrowright", "when": "pick" },

    { "command": "tree.newFile", "key": "mod+n", "when": "tree" },
    { "command": "tree.newFolder", "key": "mod+shift+n", "when": "tree" },
    { "command": "tree.open", "key": "enter", "when": "tree" },
    { "command": "tree.rename", "key": "f2", "when": "tree" },
    { "command": "tree.delete", "key": "backspace", "when": "tree" },
    { "command": "tree.copy", "key": "clip+c", "when": "tree" },
    { "command": "tree.cut", "key": "clip+x", "when": "tree" },
    { "command": "tree.paste", "key": "clip+v", "when": "tree" },
    { "command": "tree.copyPath", "key": "clip+shift+c", "when": "tree" },

    { "command": "file.reload", "key": "mod+shift+r", "when": "global" },

    { "command": "edit.undo", "key": "mod+z", "when": "editor" },
    { "command": "edit.redo", "key": "mod+shift+z", "when": "editor" },

    { "command": "git.branches", "key": "mod+backquote", "when": "global" },

    { "command": "git.push", "key": "mod+shift+k", "when": "global" },

    {
      "command": "panel.tree",
      "key": "mod+1",
      "when": "global"
    },
    {
      "command": "search.everywhere",
      "key": "mod+2",
      "when": "global"
    },
    {
      "command": "git.branches",
      "key": "mod+3",
      "when": "global"
    },
    {
      "command": "git.push",
      "key": "mod+4",
      "when": "global"
    },
    {
      "command": "scripts.open",
      "key": "mod+5",
      "when": "global"
    },
    {
      "command": "panel.problems",
      "key": "mod+6",
      "when": "global"
    },
    {
      "command": "terminal.create",
      "key": "mod+7",
      "when": "global"
    }
  ]
}
