{
  "version": 1,
  "bindings": [
    { "command": "file.save", "key": "mod+s", "when": "global" },

    { "command": "search.everywhere", "key": "double:shift", "when": "global" },
    { "command": "search.everywhere", "key": "mod+p", "when": "global" },
    { "command": "search.next", "key": "arrowdown", "when": "search" },
    { "command": "search.prev", "key": "arrowup", "when": "search" },
    { "command": "search.accept", "key": "enter", "when": "search" },
    { "command": "search.close", "key": "escape", "when": "search" },

    { "command": "projects.next", "key": "arrowdown", "when": "projects" },
    { "command": "projects.prev", "key": "arrowup", "when": "projects" },
    { "command": "projects.complete", "key": "tab", "when": "projects" },
    { "command": "projects.accept", "key": "enter", "when": "projects" },
    { "command": "projects.close", "key": "escape", "when": "projects" },

    { "command": "git.next", "key": "arrowdown", "when": "branches" },
    { "command": "git.prev", "key": "arrowup", "when": "branches" },
    { "command": "git.checkout", "key": "enter", "when": "branches" },
    { "command": "git.close", "key": "escape", "when": "branches" },

    { "command": "file.reload", "key": "mod+shift+r", "when": "global" },

    { "command": "edit.undo", "key": "mod+z", "when": "editor" },
    { "command": "edit.redo", "key": "mod+shift+z", "when": "editor" },

    {
      "command": "panel.tree",
      "key": "mod+1",
      "when": "global",
      "unavailable": {
        "browser": "Chrome переключает вкладки по Cmd+1. Запусти в app-режиме или дождись Электрона."
      }
    },
    {
      "command": "panel.problems",
      "key": "mod+2",
      "when": "global",
      "unavailable": {
        "browser": "Chrome переключает вкладки по Cmd+2. Запусти в app-режиме или дождись Электрона."
      }
    }
  ]
}
