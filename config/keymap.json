{
  "version": 1,
  "bindings": [
    { "command": "file.save", "key": "mod+s", "when": "global" },

    { "command": "search.everywhere", "key": "double:shift", "when": "global" },

    { "command": "scripts.open", "key": "double:meta", "when": "global" },
    { "command": "projects.show", "key": "double:control", "when": "global" },
    { "command": "git.branches", "key": "double:alt", "when": "global" },
    { "command": "search.everywhere", "key": "mod+p", "when": "global" },
    { "command": "search.next", "key": "arrowdown", "when": "search" },
    { "command": "search.prev", "key": "arrowup", "when": "search" },
    { "command": "search.accept", "key": "enter", "when": "search" },
    { "command": "search.close", "key": "escape", "when": "search" },

    { "command": "popup.close", "key": "escape", "when": "global" },

    { "command": "projects.next", "key": "arrowdown", "when": "projects" },
    { "command": "projects.prev", "key": "arrowup", "when": "projects" },
    { "command": "projects.suggest", "key": "mod+shift+space", "when": "projects" },
    { "command": "projects.complete", "key": "tab", "when": "projects" },
    { "command": "projects.accept", "key": "enter", "when": "projects" },
    { "command": "projects.close", "key": "escape", "when": "projects" },

    { "command": "pick.next", "key": "arrowdown", "when": "pick" },
    { "command": "pick.prev", "key": "arrowup", "when": "pick" },
    { "command": "pick.accept", "key": "enter", "when": "pick" },
    { "command": "pick.expand", "key": "arrowright", "when": "pick" },

    { "command": "prompt.confirm", "key": "enter", "when": "prompt" },

    { "command": "menu.next", "key": "arrowdown", "when": "menu" },
    { "command": "menu.prev", "key": "arrowup", "when": "menu" },
    { "command": "menu.accept", "key": "enter", "when": "menu" },

    { "command": "tree.next", "key": "arrowdown", "when": "tree" },
    { "command": "tree.prev", "key": "arrowup", "when": "tree" },
    { "command": "tree.expand", "key": "arrowright", "when": "tree" },
    { "command": "tree.collapse", "key": "arrowleft", "when": "tree" },
    {
      "command": "tree.newFile",
      "key": "mod+n",
      "keys": { "browser:win": "mod+alt+n" },
      "when": "tree"
    },
    {
      "command": "tree.newFolder",
      "key": "mod+shift+n",
      "keys": { "browser:win": "mod+alt+shift+n" },
      "when": "tree"
    },
    { "command": "tree.open", "key": "enter", "when": "tree" },
    { "command": "tree.rename", "key": "f2", "when": "tree" },
    { "command": "tree.delete", "key": "backspace", "when": "tree" },
    { "command": "tree.copy", "key": "clip+c", "when": "tree" },
    { "command": "tree.cut", "key": "clip+x", "when": "tree" },
    { "command": "tree.paste", "key": "clip+v", "when": "tree" },
    { "command": "tree.copyPath", "key": "clip+alt+shift+c", "when": "tree" },

    { "command": "file.reload", "key": "mod+shift+r", "when": "global" },

    { "command": "terminal.shell", "key": "mod+alt+t", "when": "global" },
    { "command": "tools.packageManager", "key": "mod+shift+p", "when": "global" },

    { "command": "key.reserved", "key": "tab", "when": "global" },
    { "command": "key.reserved", "key": "shift+tab", "when": "global" },

    { "command": "edit.undo", "key": "mod+z", "when": "editor" },
    { "command": "edit.redo", "key": "mod+shift+z", "when": "editor" },

    { "command": "edit.deleteLine", "key": "mod+y", "when": "editor" },
    { "command": "edit.duplicateLine", "key": "mod+d", "when": "editor" },
    { "command": "edit.toggleComment", "key": "mod+slash", "when": "editor" },
    { "command": "edit.moveLineUp", "key": "alt+shift+arrowup", "when": "editor" },
    { "command": "edit.moveLineDown", "key": "alt+shift+arrowdown", "when": "editor" },
    { "command": "edit.addCursorAbove", "key": "alt+arrowup", "when": "editor" },
    { "command": "edit.addCursorBelow", "key": "alt+arrowdown", "when": "editor" },
    { "command": "edit.indent", "key": "tab", "when": "editor" },

    { "command": "symbol.goto", "key": "mod+b", "when": "editor" },

    {
      "command": "edit.wordLeft",
      "key": "mod+arrowleft",
      "keys": { "browser:mac": "alt+arrowleft" },
      "when": "editor"
    },
    {
      "command": "edit.wordRight",
      "key": "mod+arrowright",
      "keys": { "browser:mac": "alt+arrowright" },
      "when": "editor"
    },
    {
      "command": "edit.selectWordLeft",
      "key": "mod+shift+arrowleft",
      "keys": { "browser:mac": "alt+shift+arrowleft" },
      "when": "editor"
    },
    {
      "command": "edit.selectWordRight",
      "key": "mod+shift+arrowright",
      "keys": { "browser:mac": "alt+shift+arrowright" },
      "when": "editor"
    },
    { "command": "nav.back", "key": "mod+alt+arrowleft", "when": "global" },
    { "command": "nav.forward", "key": "mod+alt+arrowright", "when": "global" },
    { "command": "nav.back", "key": "mod+bracketleft", "when": "global" },
    { "command": "nav.forward", "key": "mod+bracketright", "when": "global" },
    { "command": "edit.unindent", "key": "shift+tab", "when": "editor" },

    {
      "command": "git.branches",
      "key": "mod+backquote",
      "when": "global",
      "unavailable": {
        "electron:mac": "macOS cycles windows of the app with Cmd+`. The toolbar number still works."
      }
    },

    { "command": "git.push", "key": "mod+shift+k", "when": "global" },

    {
      "command": "panel.tree",
      "key": "mod+1",
      "keys": { "browser:win": "mod+alt+1" },
      "when": "global"
    },
    {
      "command": "search.everywhere",
      "key": "mod+2",
      "keys": { "browser:win": "mod+alt+2" },
      "when": "global"
    },
    {
      "command": "git.branches",
      "key": "mod+3",
      "keys": { "browser:win": "mod+alt+3" },
      "when": "global"
    },
    {
      "command": "git.push",
      "key": "mod+4",
      "keys": { "browser:win": "mod+alt+4" },
      "when": "global"
    },
    {
      "command": "scripts.open",
      "key": "mod+5",
      "keys": { "browser:win": "mod+alt+5" },
      "when": "global"
    },
    {
      "command": "panel.problems",
      "key": "mod+6",
      "keys": { "browser:win": "mod+alt+6" },
      "when": "global"
    },
    {
      "command": "terminal.create",
      "key": "mod+7",
      "keys": { "browser:win": "mod+alt+7" },
      "when": "global"
    },
    {
      "command": "projects.show",
      "key": "mod+8",
      "keys": { "browser:win": "mod+alt+8" },
      "when": "global"
    },
    {
      "command": "panel.editor",
      "key": "mod+9",
      "keys": { "browser:win": "mod+alt+9" },
      "when": "global"
    },
    {
      "command": "keys.show",
      "key": "mod+0",
      "when": "global"
    }
  ]
}
