{
  "name": "@mosetta/ide-plugin-merge",
  "version": "0.1.0",
  "description": "A three-way merge screen for every argument between two versions of a file \u2014 from git, from the shelf, or from the disk.",
  "license": "MIT",
  "homepage": "https://ide.mosetta.org",
  "keywords": [
    "mosetta",
    "ide",
    "mosetta-plugin"
  ],
  "files": [
    "src",
    "README.md",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/client.tsx",
    "./server": "./src/server.ts"
  },
  "ide": {
    "client": "src/client.tsx",
    "server": "src/server.ts",
    "strings": {
      "en": "src/en.json",
      "ru": "src/ru.json"
    }
  },
  "dependencies": {
    "@mosetta/ide-api": "workspace:*",
    "@mosetta/ide-plugin-doc": "workspace:*",
    "@mosetta/ide-protocol": "workspace:*",
    "@mosetta/ide-plugin-ui": "workspace:*",
    "@mosetta/ide-plugin-code": "workspace:*"
  },
  "peerDependencies": {
    "preact": "^10.25.3",
    "@preact/signals": "^1.3.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.3"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.3",
    "@preact/signals": "^1.3.1",
    "preact": "^10.25.3",
    "vitest": "^2.1.9",
    "@types/node": "^22.10.5"
  }
}
