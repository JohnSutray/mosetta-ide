{
  "name": "@mosetta/ide-plugin-completion",
  "version": "0.0.14",
  "description": "The completion list: the language server, the file's own words and postfix templates, ranked by what you actually pick.",
  "license": "MIT",
  "homepage": "https://ide.mosetta.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosetta/mosetta-ide.git",
    "directory": "plugins/completion"
  },
  "bugs": "https://github.com/mosetta/mosetta-ide/issues",
  "keywords": [
    "mosetta",
    "ide",
    "mosetta-plugin"
  ],
  "files": [
    "src",
    "README.md",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/client.tsx"
  },
  "ide": {
    "client": "src/client.tsx",
    "server": "src/server.ts",
    "strings": {
      "en": "src/en.json",
      "ru": "src/ru.json"
    }
  },
  "dependencies": {
    "@mosetta/ide-api": "workspace:*",
    "@mosetta/ide-plugin-doc": "workspace:*",
    "@mosetta/ide-plugin-lsp": "workspace:*",
    "@mosetta/ide-plugin-search": "workspace:*",
    "@mosetta/ide-plugin-code": "workspace:*"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.3",
    "@preact/signals": "^1.3.1",
    "preact": "^10.25.3"
  },
  "devDependencies": {
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.3",
    "@preact/signals": "^1.3.1",
    "@types/node": "^22.10.5",
    "preact": "^10.25.3",
    "vitest": "^2.1.9"
  }
}
