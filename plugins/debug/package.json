{
  "name": "@mosetta/ide-plugin-debug",
  "version": "0.0.13",
  "description": "DAP through vscode-js-debug: breakpoints that remember their line, stepping, variables, and a browser opened under the debugger when your server prints its address.",
  "license": "MIT",
  "homepage": "https://ide.mosetta.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosetta/mosetta-ide.git",
    "directory": "plugins/debug"
  },
  "bugs": "https://github.com/mosetta/mosetta-ide/issues",
  "keywords": [
    "mosetta",
    "ide",
    "mosetta-plugin"
  ],
  "files": [
    "src",
    "README.md",
    "vendor",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/client.tsx",
    "./server": "./src/server.ts"
  },
  "ide": {
    "client": "src/client.tsx",
    "server": "src/server.ts",
    "strings": {
      "en": "src/en.json",
      "ru": "src/ru.json"
    }
  },
  "dependencies": {
    "@mosetta/ide-api": "workspace:*",
    "@mosetta/ide-plugin-code": "workspace:*",
    "@mosetta/ide-plugin-doc": "workspace:*",
    "@mosetta/ide-plugin-keymap": "workspace:*",
    "@mosetta/ide-plugin-npm-scripts": "workspace:*",
    "@mosetta/ide-plugin-terminal": "workspace:*",
    "@mosetta/ide-plugin-ui": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.3",
    "@mosetta/ide-protocol": "workspace:*",
    "@mosetta/ide-plugin-editor": "workspace:*",
    "@mosetta/ide-plugin-lsp": "workspace:*",
    "@mosetta/ide-plugin-theme": "workspace:*",
    "@preact/signals": "^1.3.1",
    "@types/node": "^22.10.5",
    "preact": "^10.25.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.3",
    "@mosetta/ide-protocol": "workspace:*",
    "@preact/signals": "^1.3.1",
    "preact": "^10.25.3"
  }
}
