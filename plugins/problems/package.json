{
  "name": "@mosetta/ide-plugin-problems",
  "version": "0.1.0",
  "description": "Every error and warning in the project, in one panel, by file.",
  "license": "MIT",
  "homepage": "https://ide.mosetta.org",
  "keywords": [
    "mosetta",
    "ide",
    "mosetta-plugin"
  ],
  "files": [
