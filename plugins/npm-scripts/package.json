{
  "name": "@mosetta/ide-plugin-npm-scripts",
  "version": "0.0.11",
  "description": "Every script of every package.json in the project, one key away, each run in its own terminal.",
  "license": "MIT",
  "homepage": "https://ide.mosetta.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnSutray/mosetta-ide.git",
    "directory": "plugins/npm-scripts"
  },
  "bugs": "https://github.com/JohnSutray/mosetta-ide/issues",
  "keywords": [
    "mosetta",
    "ide",
    "mosetta-plugin"
  ],
  "files": [
    "src",
    "README.md",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/client.tsx"
  },
  "ide": {
    "client": "src/client.tsx",
    "server": "src/server.ts",
    "strings": {
      "en": "src/en.json",
      "ru": "src/ru.json"
    }
  },
  "dependencies": {
    "@mosetta/ide-api": "workspace:*",
    "@mosetta/ide-plugin-search": "workspace:*",
    "@mosetta/ide-plugin-terminal": "workspace:*",
    "@mosetta/ide-plugin-ui": "workspace:*"
  },
  "peerDependencies": {
    "@mosetta/ide-protocol": "workspace:*",
    "preact": "^10.25.3",
    "@preact/signals": "^1.3.1"
  },
  "devDependencies": {
    "@preact/signals": "^1.3.1",
    "preact": "^10.25.3",
    "vitest": "^2.1.9"
  }
}
