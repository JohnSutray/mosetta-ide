{
  "name": "@mosetta/ide-plugin-search",
  "version": "0.1.0",
  "description": "Shift+Shift: one window over files, symbols, scripts, terminals and settings, with a preview and typed tags.",
  "license": "MIT",
  "homepage": "https://ide.mosetta.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnSutray/mosetta-ide.git",
    "directory": "plugins/search"
  },
  "bugs": "https://github.com/JohnSutray/mosetta-ide/issues",
  "keywords": [
    "mosetta",
    "ide",
    "mosetta-plugin"
  ],
  "files": [
    "src",
    "README.md",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/client.tsx",
    "./server": "./src/server.ts"
  },
  "ide": {
    "client": "src/client.tsx",
    "server": "src/server.ts",
    "strings": {
      "en": "src/en.json",
      "ru": "src/ru.json"
    }
  },
  "dependencies": {
    "@mosetta/ide-api": "workspace:*",
    "@mosetta/ide-plugin-doc": "workspace:*",
    "@mosetta/ide-protocol": "workspace:*",
    "@mosetta/ide-plugin-ui": "workspace:*",
    "typescript": "^5.7.2",
    "@mosetta/ide-plugin-code": "workspace:*"
  },
  "peerDependencies": {
    "preact": "^10.25.3",
    "@preact/signals": "^1.3.1"
  },
  "devDependencies": {
    "@preact/signals": "^1.3.1",
    "preact": "^10.25.3",
    "vitest": "^2.1.9",
    "@types/node": "^22.10.5"
  }
}
