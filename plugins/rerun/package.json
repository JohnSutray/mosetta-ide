{
  "name": "@mosetta/ide-plugin-rerun",
  "version": "0.0.14",
  "description": "Run the last npm script again, on one key.",
  "license": "MIT",
  "homepage": "https://ide.mosetta.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosetta/mosetta-ide.git",
    "directory": "plugins/rerun"
  },
  "bugs": "https://github.com/mosetta/mosetta-ide/issues",
  "keywords": [
    "mosetta",
    "ide",
    "mosetta-plugin"
  ],
  "files": [
    "src",
    "README.md",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "ide": {
    "client": "src/client.ts",
    "strings": {
      "en": "src/en.json",
      "ru": "src/ru.json"
    },
    "needs": [
      "@mosetta/ide-plugin-npm-scripts"
    ]
  },
  "dependencies": {
    "@mosetta/ide-api": "workspace:*",
    "@mosetta/ide-plugin-npm-scripts": "workspace:*"
  },
  "devDependencies": {
    "preact": "^10.25.3",
    "vitest": "^2.1.9",
    "@mosetta/ide-plugin-terminal": "workspace:*"
  }
}
