{
  "name": "@mosetta/ide-plugin-ui",
  "version": "0.0.13",
  "description": "The IDE's windows, lists, menus, chips, tips and icons \u2014 shared by every other plugin.",
  "license": "MIT",
  "homepage": "https://ide.mosetta.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosetta/mosetta-ide.git",
    "directory": "plugins/ui"
  },
  "bugs": "https://github.com/mosetta/mosetta-ide/issues",
  "keywords": [
    "mosetta",
    "ide",
    "mosetta-plugin"
  ],
  "files": [
    "src",
    "README.md",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/client.tsx"
  },
  "ide": {
    "client": "src/client.tsx",
    "shares": [
      "AskPopup",
      "Asking",
      "Chevron",
      "Chip",
      "ChipRow",
      "ChoicePopup",
      "DirIcon",
      "FileIcon",
      "Icon",
      "Menu",
      "ModeSwitch",
      "PickPopup",
      "Popup",
      "Resizer",
      "RootIcon",
      "Tag",
      "Typeahead"
    ],
    "strings": {
      "en": "src/en.json",
      "ru": "src/ru.json"
    }
  },
  "dependencies": {
    "@mosetta/ide-api": "workspace:*",
    "@mosetta/ide-plugin-keymap": "workspace:*",
    "@mosetta/ide-protocol": "workspace:*"
  },
  "peerDependencies": {
    "preact": "^10.25.3",
    "@preact/signals": "^1.3.1"
  },
  "devDependencies": {
    "@preact/signals": "^1.3.1",
    "preact": "^10.25.3",
    "vitest": "^2.1.9",
    "@types/node": "^22.10.5"
  }
}
