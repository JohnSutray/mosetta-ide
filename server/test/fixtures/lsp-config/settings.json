// The language server test's config: this is the one place it is wanted.
{
  "fs": { "noScan": ["node_modules", ".git"], "preloadBudgetMb": 4 },
  "lsp": {
    "startOnOpen": true,
    "servers": {
      "typescript": {
        "enabled": true,
        "command": "typescript-language-server",
        "args": ["--stdio"],
        "extensions": ["ts", "tsx"]
      }
    }
  }
}
