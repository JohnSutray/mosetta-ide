{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "scripts",
    "vite.config.ts"
  ]
}