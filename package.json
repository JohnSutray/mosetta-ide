{
  "name": "web-ide",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter ./server --filter ./client dev",
    "dev:server": "pnpm --filter ./server dev",
    "dev:client": "pnpm --filter ./client dev",
    "dev:scratch": "IDE_PORT=4188 VITE_IDE_PORT=4188 pnpm --parallel --filter ./server --filter ./client dev -- --port 5188 --strictPort",
    "stable:build": "VITE_IDE_PORT=4177 pnpm --filter ./protocol build && VITE_IDE_PORT=4177 pnpm --filter ./client build",
    "stable:serve": "pnpm --parallel --filter ./server --filter ./client stable",
    "build": "pnpm --filter ./protocol build && pnpm --filter ./server build && pnpm --filter ./client build",
    "test": "pnpm --filter ./server test && pnpm --filter ./client test",
    "typecheck": "tsc -b protocol server client",
    "postinstall": "node scripts/ensure-pty-helper.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
